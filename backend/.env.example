# Copy this file to .env and replace every placeholder locally.
# Never commit .env or real credentials.
SECRET_KEY=generate-a-unique-django-secret-key
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SECURE_SSL_REDIRECT=false

DB_NAME=service_request_management
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
DEFAULT_FROM_EMAIL=webmaster@localhost

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
DASHBOARD_SUMMARY_CACHE_TIMEOUT=60
CACHE_KEY_PREFIX=service-request-management
